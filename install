#!/usr/bin/env bash
# install - build lazytui and install it for the current user: no root; the one flag is -rebuild (full rebuild first).
# liblazytui.a and lazytui.h go to ~/.local/lib and ~/.local/include (cc -I~/.local/include prog.c -L~/.local/lib -llazytui -lm),
# the demo runs as `lazytui-demo`, and the example sources (demo.c, TUItemplate.c) are copied to share/lazytui/examples.
# PREFIX=/usr/local (and sudo) installs system-wide, DESTDIR is for packagers. Nothing outside the prefix is touched.
set -eu
cd "$(dirname "$(readlink -f "$0")")"
rebuild=
[ "${1:-}" = -rebuild ] && { rebuild=1; shift; }
[ $# -eq 0 ] || { echo "install: the only argument is -rebuild (full rebuild first); PREFIX=... in the environment changes the target" >&2; exit 2; }
export BUILD_FORCE=$rebuild
prefix=${PREFIX:-$HOME/.local}
dest=${DESTDIR:-}$prefix
./build > /dev/null
make --quiet install PREFIX="$prefix" DESTDIR="${DESTDIR:-}"
install -d "$dest/bin" "$dest/share/lazytui/examples"
install -m 755 examples/demo "$dest/bin/lazytui-demo"
install -m 644 examples/demo.c examples/TUItemplate.c "$dest/share/lazytui/examples/"
echo "lazytui installed: $dest/lib/liblazytui.a, $dest/include/lazytui.h, $dest/bin/lazytui-demo, examples in $dest/share/lazytui/examples"
case ":$PATH:" in
	*":$dest/bin:"*) ;;
	*) [ -n "${DESTDIR:-}" ] || echo "note: $prefix/bin is not in PATH; add it to your shell profile" ;;
esac
